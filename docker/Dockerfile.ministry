FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock /app/
COPY src /app/src
COPY scenarios /app/scenarios

RUN pip install --no-cache-dir /app

ENV ENCLOSURE_WORLD=/var/enclosure/world.db
ENV MINISTRY_TOKEN=inner-party
RUN mkdir -p /var/enclosure
EXPOSE 80
CMD ["enclosure", "serve", "--host", "0.0.0.0", "--port", "80", "--world", "/var/enclosure/world.db", "--scenario", "/app/scenarios/times/python4.yaml", "--treatment", "T0"]
