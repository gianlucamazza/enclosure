# ghcr.io/astral-sh/uv:0.13.6 — refresh: docker buildx imagetools inspect ghcr.io/astral-sh/uv:0.13.6
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

# python:3.12-slim — refresh: docker buildx imagetools inspect python:3.12-slim
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nginx \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE /app/
COPY src /app/src
COPY scenarios /app/scenarios

ENV PATH="/app/.venv/bin:$PATH"
RUN UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    uv sync --frozen --no-dev --no-editable \
    && rm -f /usr/local/bin/uv

COPY docker/certs/cert.pem docker/certs/key.pem /certs/
ENV ENCLOSURE_WORLD=/var/enclosure/world.db
ENV ENCLOSURE_SCENARIOS=/app/scenarios
ENV MINISTRY_TLS_CERT=/certs/cert.pem
ENV MINISTRY_TLS_KEY=/certs/key.pem
RUN mkdir -p /var/enclosure
EXPOSE 80
CMD ["enclosure", "serve", "--host", "0.0.0.0", "--port", "80", "--world", "/var/enclosure/world.db", "--scenario", "/app/scenarios/times/python4.yaml", "--treatment", "T0"]
