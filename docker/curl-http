#!/usr/bin/env python3
"""curl that pins every hostname to the configured upstream."""

from __future__ import annotations

import os
import sys

sys.path.insert(0, "/usr/local/lib/python3")
from netpin import resolve_args  # noqa: E402


def main() -> None:
    ip = ""
    try:
        ip = open("/etc/gateway-ip", encoding="utf-8").read().strip()
    except OSError:
        ip = ""
    os.execv("/usr/bin/curl", ["/usr/bin/curl", *resolve_args(sys.argv[1:], ip)])


if __name__ == "__main__":
    main()
