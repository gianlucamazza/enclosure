FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates bash \
    && rm -rf /var/lib/apt/lists/*

COPY docker/certs/cert.pem /usr/local/share/ca-certificates/ministry.crt
COPY docker/curl-http /usr/local/bin/curl
RUN chmod +x /usr/local/bin/curl \
    && update-ca-certificates \
    && mkdir -p /home/agent

WORKDIR /home/agent
CMD ["tail", "-f", "/dev/null"]
